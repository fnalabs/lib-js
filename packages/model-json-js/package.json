{
  "name": "model-json-js",
  "version": "1.0.6",
  "description": "A JavaScript Model class that implements a serializable solution for data modeling on the client and/or server.",
  "keywords": [
    "json",
    "JSON",
    "jsonschema",
    "json-schema",
    "schema",
    "serialization"
  ],
  "main": "index.js",
  "scripts": {
    "prebuild": "del dist",
    "build": "tsc --build",
    "build:watch": "tsc --build --watch",
    "dev": "npm run build:watch & npm run test:watch",
    "document": "jsdoc --configure .jsdoc.json --verbose",
    "postdocument": "sed -i 's/Documentation/model-json-js/g' ../../../model-json-js/docs/index.html ../../../model-json-js/docs/Model.html ../../../model-json-js/docs/Schema.html",
    "fix": "",
    "lint": "",
    "release": "npm test && npm run build",
    "postrelease": "npm run document",
    "pretest": "del coverage",
    "test": "",
    "posttest": "cross-env NODE_ENV=test jest --env=node --colors --coverage 'tst'",
    "test:watch": "cross-env NODE_ENV=test jest --env=node --colors --coverage --watch 'tst'",
    "version": "npm run release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fnalabs/lib-js.git",
    "directory": "packages/model-json-js"
  },
  "bugs": {
    "url": "https://github.com/fnalabs/lib-js/issues"
  },
  "homepage": "https://fnalabs.github.io/model-json-js/",
  "author": "Adam Eilers",
  "license": "MIT",
  "engines": {
    "node": ">=10",
    "npm": ">=6"
  },
  "devDependencies": {
    "@eslint/js": "8.57.1",
    "@types/jest": "30.0.0",
    "@types/json-schema": "7.0.15",
    "codecov": "3.8.2",
    "cross-env": "10.1.0",
    "del-cli": "8.0.1",
    "eslint": "8.57.1",
    "globals": "13.24.0",
    "jest": "30.5.2",
    "jsdoc": "4.0.5",
    "prettier": "3.9.10",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "peerDependencies": {
    "schema-json-js": "1.0.6"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "collectCoverageFrom": [
      "src/**/*.{ts,js}",
      "!src/config.ts",
      "!src/**/*.d.ts",
      "!tst/**/*.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        "tsconfig.json"
      ]
    }
  },
  "volta": {
    "extends": "../../package.json"
  }
}
